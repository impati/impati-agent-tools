{
  "description": "모든 Codex 세션에 Impati 공통 작업 원칙을 주입한다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "statusMessage": "Impati 작업 원칙을 불러오는 중",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
